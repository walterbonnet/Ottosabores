    paddingTop: 3.5, // leave room for progress bar
  },
  playerThumbnail: {
    width: 38,
    height: 38,
    borderRadius: Theme.roundness.xs,
    backgroundColor: Theme.colors.surfaceDark,
  },
  playerDetails: {
