    backgroundColor: 'rgba(255, 253, 249, 0.96)',
    borderRadius: Theme.roundness.md,
    borderWidth: 1.5,
    borderColor: 'rgba(232, 226, 213, 0.9)',
    overflow: 'hidden',
    ...Theme.shadows.md,
    zIndex: 999,
  },
  progressBarBg: {
    width: '100%',
    height: 3.5,
    backgroundColor: 'rgba(232, 226, 213, 0.5)',
    position: 'absolute',
